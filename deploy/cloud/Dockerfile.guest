# The default base is the official Debian 13 multi-platform manifest.
# A build may select another verified Debian 13 base with BASE_IMAGE.
ARG BASE_IMAGE=debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
FROM ${BASE_IMAGE}

ENV container=docker
COPY apt-bootstrap.sh /usr/local/lib/cage-apt-bootstrap
COPY restore-apt-sources.sh /usr/local/lib/cage-image-restore-sources
ARG DEBIAN_MIRROR=http://deb.debian.org
RUN sed -i "s#http://deb.debian.org#${DEBIAN_MIRROR}#g" /etc/apt/sources.list.d/debian.sources \
    && printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d \
    && sh /usr/local/lib/cage-apt-bootstrap \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       systemd systemd-sysv dbus dbus-user-session libpam-systemd sudo \
       openssh-server openssh-client iproute2 fuse3 sshfs socat \
       ca-certificates curl git jq python3 python3-apt zsh procps \
    && rm /usr/sbin/policy-rc.d \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --user-group --shell /bin/bash cage \
    && printf 'cage ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/cage \
    && chmod 0440 /etc/sudoers.d/cage \
    && printf 'user_allow_other\n' > /etc/fuse.conf \
    && install -d -m 0700 -o cage -g cage /home/cage/.ssh \
    && install -d -m 0755 /etc/systemd/system.conf.d \
    && printf '[Manager]\nDefaultTasksMax=infinity\n' > /etc/systemd/system.conf.d/90-cage-container.conf \
    && install -d -m 0755 /etc/ssh/sshd_config.d /etc/systemd/system/ssh.service.d \
    && printf '%s\n' 'PermitRootLogin no' 'PasswordAuthentication no' \
       'KbdInteractiveAuthentication no' 'AuthenticationMethods publickey' \
       'AuthorizedKeysFile /etc/ssh/cage_authorized_keys' 'AllowTcpForwarding yes' \
       'GatewayPorts no' 'X11Forwarding no' 'AllowUsers cage' \
       > /etc/ssh/sshd_config.d/10-cage.conf \
    && printf '[Service]\nExecStartPre=\nExecStartPre=/usr/bin/ssh-keygen -A\nExecStartPre=/usr/sbin/sshd -t\n' \
       > /etc/systemd/system/ssh.service.d/10-cage-hostkeys.conf \
    && systemctl enable ssh.service \
    && rm -f /etc/ssh/ssh_host_* /etc/machine-id /var/lib/dbus/machine-id \
    && touch /etc/machine-id \
    && ln -s /etc/machine-id /var/lib/dbus/machine-id \
    && sh /usr/local/lib/cage-image-restore-sources

# PID 1 owns its services. Container stop must let systemd stop them in order.
# Persistent files remain in the same container until an explicit migration.
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
