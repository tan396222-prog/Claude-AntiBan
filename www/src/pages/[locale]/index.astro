---
import CageHome from '../../components/CageHome.astro';
import { languages } from '../../i18n/cage';
export function getStaticPaths() {
  return languages.filter(language => language.code !== 'zh').map(language => ({ params: { locale: language.code }, props: { locale: language.code } }));
}
const { locale } = Astro.props;
---
<CageHome locale={locale} />
