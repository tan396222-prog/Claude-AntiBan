Subject: [PATCH] Expose WHPX-supported SSE features in the Windows qemu64 fallback

Keep the explicit CPU model and newer QEMU host passthrough. On Windows
x64, use WHvGetCapability to select additional qemu64 features.

diff --git a/pkg/driver/qemu/cpu_other.go b/pkg/driver/qemu/cpu_other.go
new file mode 100644
index 0000000..99a48c3
--- /dev/null
+++ b/pkg/driver/qemu/cpu_other.go
@@ -0,0 +1,9 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+//go:build !windows || !amd64
+
+package qemu
+
+// Only the Windows amd64 driver defaults to qemu64.
+func whpxQEMU64() string { return "qemu64" }
diff --git a/pkg/driver/qemu/cpu_windows_amd64.go b/pkg/driver/qemu/cpu_windows_amd64.go
new file mode 100644
index 0000000..77bdb8c
--- /dev/null
+++ b/pkg/driver/qemu/cpu_windows_amd64.go
@@ -0,0 +1,50 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package qemu
+
+import (
+	"unsafe"
+
+	"github.com/sirupsen/logrus"
+	"golang.org/x/sys/windows"
+)
+
+func whpxQEMU64() string {
+	// Query the processor features available to Windows Hypervisor Platform
+	// guests. A nested hypervisor may expose a subset of the host's CPUID.
+	query := windows.NewLazySystemDLL("WinHvPlatform.dll").NewProc("WHvGetCapability")
+	if err := query.Find(); err != nil {
+		logrus.WithError(err).Warn("Cannot query WHPX processor features; using qemu64 defaults")
+		return "qemu64"
+	}
+	const processorFeatures = 0x1001 // WHvCapabilityCodeProcessorFeatures
+	var bits uint64
+	var written uint32
+	status, _, _ := query.Call(processorFeatures, uintptr(unsafe.Pointer(&bits)),
+		unsafe.Sizeof(bits), uintptr(unsafe.Pointer(&written)))
+	if int32(status) < 0 || uintptr(written) != unsafe.Sizeof(bits) {
+		logrus.Warnf("Cannot query WHPX processor features (HRESULT %#x, %d bytes); using qemu64 defaults", uint32(status), written)
+		return "qemu64"
+	}
+	return whpxQEMU64Model(bits)
+}
+
+// Bit positions are from the Windows SDK's WHV_X64_PROCESSOR_FEATURES.
+func whpxQEMU64Model(bits uint64) string {
+	model := "qemu64"
+	for _, feature := range []struct {
+		mask uint64
+		flag string
+	}{
+		{1 << 2, "+ssse3"},
+		{1 << 3, "+sse4.1"},
+		{1 << 4, "+sse4.2"},
+		{1 << 7, "+popcnt"},
+	} {
+		if bits&feature.mask != 0 {
+			model += "," + feature.flag
+		}
+	}
+	return model
+}
diff --git a/pkg/driver/qemu/cpu_windows_amd64_test.go b/pkg/driver/qemu/cpu_windows_amd64_test.go
new file mode 100644
index 0000000..d4e0f08
--- /dev/null
+++ b/pkg/driver/qemu/cpu_windows_amd64_test.go
@@ -0,0 +1,44 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package qemu
+
+import (
+	"testing"
+
+	"github.com/coreos/go-semver/semver"
+
+	"github.com/lima-vm/lima/v2/pkg/limatype"
+)
+
+func TestWHPXQEMU64Features(t *testing.T) {
+	for bits, want := range map[uint64]string{
+		0:    "qemu64",
+		0x60: "qemu64", // AMD SSE4a and XOP do not imply SSE4.2.
+		0x0c: "qemu64,+ssse3,+sse4.1",
+		0x9c: "qemu64,+ssse3,+sse4.1,+sse4.2,+popcnt",
+	} {
+		if got := whpxQEMU64Model(bits); got != want {
+			t.Errorf("WHPX feature mask %#x: got %q, want %q", bits, got, want)
+		}
+	}
+}
+
+func TestWindowsCPUResolution(t *testing.T) {
+	arch := limatype.X8664
+	y := limatype.LimaYAML{Arch: &arch}
+	// New and existing instances with no explicit CPU override both resolve
+	// against the current host each time their QEMU command is generated.
+	if got, want := resolveCPUType(&y, semver.New("11.1.0")), whpxQEMU64(); got != want {
+		t.Fatalf("default for QEMU 11.1.0: got %q, want %q", got, want)
+	}
+	if got := resolveCPUType(&y, semver.New("11.1.1")); got != "host" {
+		t.Fatalf("default for QEMU 11.1.1: got %q", got)
+	}
+	for _, override := range []string{"qemu64", "qemu64,+sse4.2", "Nehalem"} {
+		y.VMOpts = limatype.VMOpts{limatype.QEMU: limatype.QEMUOpts{CPUType: limatype.CPUType{arch: override}}}
+		if got := resolveCPUType(&y, semver.New("11.1.0")); got != override {
+			t.Fatalf("explicit CPU type %q changed to %q", override, got)
+		}
+	}
+}
diff --git a/pkg/driver/qemu/qemu.go b/pkg/driver/qemu/qemu.go
index 2dba8c5..e70322a 100644
--- a/pkg/driver/qemu/qemu.go
+++ b/pkg/driver/qemu/qemu.go
@@ -458,6 +458,11 @@ func resolveCPUType(y *limatype.LimaYAML, qemuVersion *semver.Version) string {
 	if err := limayaml.Convert(y.VMOpts[limatype.QEMU], &qemuOpts, "vmOpts.qemu"); err != nil {
 		logrus.WithError(err).Warnf("Couldn't convert %#q", y.VMOpts[limatype.QEMU])
 	}
+	// WHPX uses qemu64 when host passthrough is unavailable. Preserve an
+	// explicit CPU model, including an explicitly requested bare qemu64.
+	if cpuType[*y.Arch] == "qemu64" && qemuOpts.CPUType[*y.Arch] == "" {
+		cpuType[*y.Arch] = whpxQEMU64()
+	}
 	for k, v := range qemuOpts.CPUType {
 		if !slices.Contains(limatype.ArchTypes, *y.Arch) {
 			logrus.Warnf("field `vmOpts.qemu.cpuType` uses unsupported arch %#q", k)
@@ -1407,7 +1412,7 @@ func hasHostCPU(qemuVersion *semver.Version) bool {
 		return true
 	case "windows":
 		// Should have been 11.1.0, but it contained a regression when running in nested virt
-		if qemuVersion.LessThan(*semver.New("11.1.1")) {
+		if qemuVersion == nil || qemuVersion.LessThan(*semver.New("11.1.1")) {
 			return false
 		}
 		return true
