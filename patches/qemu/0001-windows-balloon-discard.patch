+typedef struct BalloonDiscardBatch BalloonDiscardBatch;
+
+#ifdef _WIN32
+typedef struct BalloonDiscardRange {
+    RAMBlock *rb;
+    MemoryRegion *mr;
+    ram_addr_t offset;
+    hwaddr guest;
+    size_t size;
+} BalloonDiscardRange;
+
+struct BalloonDiscardBatch {
+    BalloonDiscardRange ranges[256];
+    size_t count;
+};
+
+static void balloon_windows_discard(RAMBlock *rb, ram_addr_t offset,
+                                    hwaddr guest, size_t size)
+{
+    void *addr = qemu_ram_get_host_addr(rb) + offset;
+
+    /* WHPX must release its backing before Windows can reclaim these pages. */
+    if (whpx_enabled() && whpx_balloon_mapping(false, addr, guest, size) < 0) {
+        return;
+    }
+    if (!VirtualFree(addr, size, MEM_DECOMMIT)) {
+        error_report_once("Could not decommit Windows balloon pages (error %lu)",
+                          (unsigned long)GetLastError());
+    } else if (!VirtualAlloc(addr, size, MEM_COMMIT, PAGE_READWRITE)) {
+        /* RAMBlock users require accessible host addresses even while the guest
+         * lends these pages to the balloon. Windows allocates backing on touch. */
+        error_report("Could not recommit Windows balloon pages (error %lu)",
+                     (unsigned long)GetLastError());
+        exit(1);
+    }
+    if (whpx_enabled() && whpx_balloon_mapping(true, addr, guest, size) < 0) {
+        /* Resume only after the guest can access the recommitted range. */
+        exit(1);
+    }
+}
+
+static int balloon_discard_range_compare(const void *left, const void *right)
+{
+    const BalloonDiscardRange *a = left;
+    const BalloonDiscardRange *b = right;
+
+    if (a->rb != b->rb) {
+        return (uintptr_t)a->rb < (uintptr_t)b->rb ? -1 : 1;
+    }
+    return (a->offset > b->offset) - (a->offset < b->offset);
+}
+
+static void balloon_discard_batch_flush(BalloonDiscardBatch *batch)
+{
+    size_t i = 0;
+
+    qsort(batch->ranges, batch->count, sizeof(batch->ranges[0]),
+          balloon_discard_range_compare);
+    while (i < batch->count) {
+        BalloonDiscardRange *first = &batch->ranges[i++];
+        ram_addr_t end = first->offset + first->size;
+
+        while (i < batch->count && batch->ranges[i].rb == first->rb &&
+               batch->ranges[i].offset <= end &&
+               batch->ranges[i].guest == first->guest +
+                   batch->ranges[i].offset - first->offset) {
+            end = MAX(end, batch->ranges[i].offset + batch->ranges[i].size);
+            i++;
+        }
+        balloon_windows_discard(first->rb, first->offset, first->guest,
+                                end - first->offset);
+    }
+    for (i = 0; i < batch->count; i++) {
+        memory_region_unref(batch->ranges[i].mr);
+    }
+    batch->count = 0;
+}
+#endif
+
+/* Balloon and free-page reporting hand over unused guest pages. Their
+ * contents are unspecified when the guest takes them back. */
+static void balloon_discard_range(RAMBlock *rb, ram_addr_t offset, size_t size,
+                                  MemoryRegion *mr, BalloonDiscardBatch *batch,
+                                  hwaddr guest)
+{
+#ifdef _WIN32
+    /* Batch adjacent pages to reduce Windows memory operations. Retain each region
+     * until the batch is complete, before acknowledging the virtqueue entry. */
+    if (batch) {
+        if (batch->count == ARRAY_SIZE(batch->ranges)) {
+            balloon_discard_batch_flush(batch);
+        }
+        memory_region_ref(mr);
+        batch->ranges[batch->count++] = (BalloonDiscardRange) {
+            .rb = rb, .mr = mr, .offset = offset, .guest = guest, .size = size,
+        };
+    } else {
+        balloon_windows_discard(rb, offset, guest, size);
+    }
+#else
+    ram_block_discard_range(rb, offset, size);
+#endif
+}
