+int whpx_balloon_mapping(bool add, void *host, uint64_t guest, size_t size)
+{
+    HRESULT hr;
+
+    if (add) {
+        hr = whp_dispatch.WHvMapGpaRange(whpx_global.partition, host, guest, size,
+                WHvMapGpaRangeFlagRead | WHvMapGpaRangeFlagWrite |
+                WHvMapGpaRangeFlagExecute);
+    } else {
+        hr = whp_dispatch.WHvUnmapGpaRange(whpx_global.partition, guest, size);
+    }
+    if (FAILED(hr)) {
+        error_report_once("WHPX balloon %s failed (0x%08lx)",
+                          add ? "map" : "unmap", (unsigned long)hr);
+        return -EIO;
+    }
+    return 0;
+}
