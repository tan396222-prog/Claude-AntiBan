Subject: [PATCH] Route cage TCP and DNS through host-owned transports

Optional transport hooks retain the upstream default. DNS exchange failures
return SERVFAIL without invoking the host resolver. Cage supplies a proxy-only
TCP dialer and DoH exchange outside the guest.

---
diff --git a/pkg/services/dns/dns.go b/pkg/services/dns/dns.go
index 968331a..3ee284a 100644
--- a/pkg/services/dns/dns.go
+++ b/pkg/services/dns/dns.go
@@ -24,6 +24,7 @@ type upstreamResolver interface {
 }
 
 type dnsHandler struct {
+	exchange  func(context.Context, *dns.Msg) (*dns.Msg, error)
 	zones     []types.Zone
 	zonesLock sync.RWMutex
 	upstream  upstreamResolver
@@ -36,7 +37,16 @@ func (h *dnsHandler) handle(w dns.ResponseWriter, r *dns.Msg, responseMessageSiz
 	m := new(dns.Msg)
 	m.SetReply(r)
 	m.RecursionAvailable = true
-	h.addAnswers(m)
+	if h.exchange != nil {
+		answer, err := h.exchange(context.Background(), r)
+		if err != nil {
+			m.SetRcode(r, dns.RcodeServerFailure)
+		} else {
+			m = answer
+		}
+	} else {
+		h.addAnswers(m)
+	}
 	edns0 := r.IsEdns0()
 	if edns0 != nil {
 		responseMessageSize = int(edns0.UDPSize())
@@ -332,3 +342,8 @@ func (s *Server) addZone(req types.Zone) {
 	// No existing zone for req.Name, add new one
 	s.handler.zones = append(s.handler.zones, req)
 }
+
+// SetExchange replaces all upstream DNS resolution; errors never fall back.
+func (s *Server) SetExchange(exchange func(context.Context, *dns.Msg) (*dns.Msg, error)) {
+	s.handler.exchange = exchange
+}
